msgid "Error saving changes"
msgstr "S'ha produït un error en guardar els canvis"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:214
msgid "Unabled to load holidays list"
msgstr "No es possible carregar la llista de festius"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:216
msgid "Unabled to import list. List blocked for other user"
msgstr ""
"No es pot importar la llista. La llista està bloquejada per un altre usuari"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:218
msgid "Error importing the list of holidays"
msgstr "S'ha produït un error en importar la llista de festius"

