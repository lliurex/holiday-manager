msgstr "El festiu s'ha editat correctament"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:234
msgid "List of holidays exported successfully"
msgstr "La llista de festius s'ha exportat correctament"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:236
msgid "Holiday deleted successfully"
msgstr "El festiu s'ha eliminat correctament"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:238
