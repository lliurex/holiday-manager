msgid "The list of holidays to be imported does not exist"
msgstr "La llista de festius que s'ha d'importar no existeix"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:222
msgid "Error exporting the list of holidays"
msgstr "S'ha produït un error en exportar la llista de festius"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:224
msgid "Changes apply succesfully"
msgstr "Els canvis s'han aplicat correctament"

