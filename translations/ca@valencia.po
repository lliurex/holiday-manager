#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:136
msgid ""
"The list of holidays will be deleted.\n"
"Do yo want to continue?"
msgstr ""
"La llista de festius actual s'eliminarà.\n"
"Voleu continuar?"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:137
msgid ""
"The holiday will be deleted.\n"
"Do yo want to continue?"
msgstr ""
"El festiu s'eliminarà.\n"
"Voleu continuar?"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:143
#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:169
msgid "Accept"
msgstr "Accepta"

#: holiday-manager/python3-holidaymanager/rsrc/HolidayInfo.qml:164
msgid ""
"New holidays list will be loaded and replace the existing configutation.\n"
"Do you want to continue?"
msgstr ""
"Ara es carregarà una nova llista de festius que reemplaçarà la configuració "
"existent.\n"
"Voleu continuar?"

